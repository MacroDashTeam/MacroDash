              </div>
            </button>
          </div>
        </div>
      </div>
      <div
        class="rounded-lg border text-card-foreground shadow-sm col-span-9 p-6 border-zinc-800 bg-zinc-900/50"
      >
        <h2
          class="font-semibold mb-4"
        >
          Chart
        </h2>
        <div
          class="h-[500px] flex items-center justify-center text-zinc-500"
        >
          <div
            class="text-center"
          >
            <svg
              aria-hidden="true"
              class="lucide lucide-trending-up w-16 h-16 mx-auto mb-4 opacity-50"
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M16 7h6v6"
              />
              <path
                d="m22 7-8.5 8.5-5-5L2 17"
              />
            </svg>
            <p
              class="text-lg"
            >
              Select series and click "Run Analysis"
            </p>
            <p
              class="text-sm mt-2"
            >
              Available functions: sma(), ema(), returns(), quantile(), adf_test(), arima(), arima_auto()
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;
