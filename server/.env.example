# FRED API Configuration
FRED_API_KEY=your_fred_api_key_here

# Alpha Vantage API Configuration
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# OpenAI API Configuration (for AI Chatbot & Insights)
OPENAI_API_KEY=your_openai_api_key_here

# CoinMarketCap API Configuration
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Django Configuration
DEBUG=True
SECRET_KEY=your_secret_key_here

# Database Configuration
# For production with PostgreSQL (Neon.tech, Supabase, AWS RDS, etc.):
# Uncomment and set DATABASE_URL below:
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
#
# For local development, leave DATABASE_URL commented out to use SQLite
#
# Example Neon.tech connection string:
# DATABASE_URL=postgresql://username:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require